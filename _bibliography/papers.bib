@thesis{noselidze2025adversarial,
  abbr={Thesis},
  bibtex_show={true},
  title={Adversarial Examples Against Vision Transformers},
  author={Noselidze, Tamar},
  school={Charles University (Supervised by Doc. Mgr. Martin Pilát, Ph.D.)},
  year={2025},
  month={June},
  url={https://dspace.cuni.cz/handle/20.500.11956/200886},
  html={https://dspace.cuni.cz/handle/20.500.11956/200886},
  pdf={thesis_final.pdf},
  code={https://github.com/TamarNoselidze/Thesis},
  abstract={Deep learning models have been remarkably successful in image classification tasks, although they still remain vulnerable to adversarial examples. These are modified input images, designed in a special way to fool victim models into making incorrect predictions. Among adversarial methods, we focus on patch-based attacks as they pose security risks, due to their physical applicability in real-world scenarios. This thesis explores the effectiveness of patch-based adversarial attacks against Vision Transformers, as well as their transferability across model architectures. We begin with evaluating the effectiveness of several white-box gradient-based methods on Vision Transformers and compare it to Convolutional Neural Networks. We then replicate an existing patch-based attack, called G-Patch and further build on it. Our contributions include a novel Mini-Patch method with three deployment strategies: random placement, corner-point and token-replacement. We carried out extensive experiments in each setting and learned that corner-point patches perform comparably to state-of-the-art methods. We further investigate transferability in both G-Patch and Mini-Patch settings, which revealed that mixed-architecture ensembles help with generalisability of adversarial examples. Overall, our work provides insights into ViT model vulnerabilities and how they compare to CNNs, as well as attack transferability.},
  selected={true}
}
