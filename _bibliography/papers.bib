  title={Quantum Nonlocality and SVMs: Classification of Local Hidden States via 9D Fano Feature Representations},
  author={Noselidze, Tamar},
  journal={Research Technical Report, UNICAMP & Sorbonne University},
  year={2026},
  code={https://github.com/TamarNoselidze/SVM-Nonlocality-Boundary},
  abstract={We engineer a support vector machine (SVM) pipeline to classify Local Hidden States (LHS) and quantum steerability boundaries by compressing 2-qubit density matrices into a 9-dimensional Fano feature representation. By overcoming linear programming bottlenecks via MOSEK-accelerated convex optimisation, we extract analytical algebraic boundaries characterising quantum nonlocality.},
